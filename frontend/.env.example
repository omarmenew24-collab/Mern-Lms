VITE_API_URL=http://localhost:3000/api
# Optional in dev (fallback test key is used). Required in production builds.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Direct lecture video upload (browser → Cloudinary). Use the same cloud name as backend CLOUD_NAME.
# In Cloudinary: Settings → Upload → add an Unsigned preset, Media type: Video, optional folder.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_VIDEO_UPLOAD_PRESET=your_unsigned_video_preset

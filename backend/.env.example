MONGODB_URI=your_mongodb_connection_string
PORT=3000

# Auth (JWT access + refresh — required)
ACCESS_TOKEN_SECRET=your_long_random_secret
REFRESH_TOKEN_SECRET=your_other_long_random_secret

GOOGLE_CLIENT_ID=your_google_client_id

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret
# Lecture videos: Cloudinary (browser) or Vimeo (TUS from browser after init from API). See frontend VITE_CLOUDINARY_* and Create lecture UI.
# Vimeo: create an app at developer.vimeo.com, then create a personal access token with scopes "upload" and "edit" (not the client secret).
# VIMEO_ACCESS_TOKEN=

NODE_ENV=development

# Must match frontend VITE_COOKIE_AUTH_HEADER_VALUE (use a long random value in production)
COOKIE_AUTH_HEADER_VALUE=1

# Public URL of this API (no trailing slash). Used in verification email links, e.g. https://api.yoursite.com
API_PUBLIC_URL=http://localhost:3000

# Where the SPA lives (no trailing slash). Used after email verification redirect.
FRONTEND_URL=http://localhost:5173

# Local dev only: "true" while NODE_ENV=development allows password login when emailVerified is false (e.g. fake test emails). Never set in production.
# DEV_ALLOW_UNVERIFIED_LOGIN=false

# Optional: when all four are set, new password signups must verify email before login.
# Password reset emails also require SMTP.
# If unset, signup behaves as before (immediate login).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Rate limits (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=8
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_PAYMENT_WINDOW_MS=900000
RATE_LIMIT_PAYMENT_MAX=60
